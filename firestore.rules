rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : "runner"; }
    function isSuperAdmin() { return signedIn() && role() == "super_admin"; }
    function isOrganizer() { return signedIn() && (role() == "organizer" || role() == "super_admin"); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function eventDoc(eventId) { return get(/databases/$(database)/documents/events/$(eventId)); }
    function isEventOwner(eventId) { return signedIn() && eventDoc(eventId).data.ownerUid == request.auth.uid; }
    function isEventMember(eventId) { return signedIn() && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)); }
    function managesEvent(eventId) { return isSuperAdmin() || (isOrganizer() && isEventOwner(eventId)); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      // El perfil se crea/normaliza mediante Cloud Functions. El usuario solo puede
      // editar campos no privilegiados de su propio perfil en fases posteriores.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.uid == request.auth.uid
                    && !request.resource.data.keys().hasAny(["role", "roleMirror", "accountStatus", "permissions"]);
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "displayName", "firstName", "lastName", "photoURL", "preferences", "updatedAt"
                    ]);
      allow delete: if false;
    }

    match /events/{eventId} {
      allow create: if verified() && isOrganizer()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == "draft";
      allow read: if signedIn() && (isSuperAdmin() || resource.data.ownerUid == request.auth.uid || isEventMember(eventId));
      allow update: if verified() && managesEvent(eventId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt;
      // Borrado físico deshabilitado: V2 usará archivado/papelera desde backend.
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || managesEvent(eventId));
        allow create, update: if verified() && managesEvent(eventId);
        allow delete: if verified() && managesEvent(eventId);
      }

      match /courses/{courseId} {
        allow read: if signedIn() && (managesEvent(eventId) || isEventMember(eventId));
        allow write: if verified() && managesEvent(eventId);
      }

      match /checkpoints/{checkpointId} {
        allow read: if signedIn() && (managesEvent(eventId) || isEventMember(eventId));
        allow write: if verified() && managesEvent(eventId);
      }

      match /results/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || managesEvent(eventId));
        // El corredor no puede declarar por sí mismo un resultado "oficial".
        allow create, update: if verified() && managesEvent(eventId);
        allow delete: if false;
      }

      match /audit/{logId} {
        allow read: if signedIn() && managesEvent(eventId);
        allow write: if false; // Solo Admin SDK / Cloud Functions.
      }
    }

    match /invitations/{inviteId} {
      allow read: if signedIn() && (resource.data.targetUid == request.auth.uid || resource.data.createdBy == request.auth.uid || isSuperAdmin());
      allow write: if false; // Creación/aceptación atómica mediante Functions.
    }

    match /organizations/{orgId} {
      allow read: if signedIn() && (isSuperAdmin() || exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)));
      allow write: if false;
      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
        allow write: if false;
      }
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
