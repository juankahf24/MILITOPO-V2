rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : "runner"; }
    function isSuperAdmin() { return signedIn() && role() == "super_admin"; }
    function isOrganizer() { return signedIn() && (role() == "organizer" || role() == "super_admin"); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function validUsernameKey(key) {
      return key is string && key.size() >= 3 && key.size() <= 24 && key.matches('^[a-z0-9._-]+$');
    }
    function usernameDoc(key) { return get(/databases/$(database)/documents/usernames/$(key)); }
    function eventDoc(eventId) { return get(/databases/$(database)/documents/events/$(eventId)); }
    function isEventOwner(eventId) { return signedIn() && eventDoc(eventId).data.ownerUid == request.auth.uid; }
    function isEventMember(eventId) { return signedIn() && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)); }
    function managesEvent(eventId) { return isSuperAdmin() || (isOrganizer() && isEventOwner(eventId)); }
    function validEventStatus(status) {
      return status == "draft" || status == "prepared" || status == "published" ||
             status == "live" || status == "finished" || status == "archived";
    }
    function validEventTransition(before, after) {
      return before == after ||
             (before == "draft" && after == "prepared") ||
             (before == "prepared" && after == "published") ||
             (before == "published" && after == "live") ||
             (before == "live" && after == "finished") ||
             (before == "finished" && after == "archived");
    }
    function preparedDataReady(data) {
      return data.checkpointSyncedCount is int && data.checkpointSyncedCount >= 3 &&
             data.courseSyncedCount is int && data.courseSyncedCount >= 1;
    }
    function designEditableStatus(status) {
      return status == "draft" || status == "prepared";
    }
    function lifecycleOnlyAfterPublication() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "cloudStage", "lifecycleVersion", "updatedAt",
        "publishedAt", "liveAt", "finishedAt", "archivedAt"
      ]);
    }

    function selfJoinFromAcceptedInvite(eventId, uid) {
      let invite = getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data;
      return verified()
             && request.auth.uid == uid
             && request.auth.token.email is string
             && request.resource.data.keys().hasOnly([
               "uid", "email", "role", "status", "invitationId", "joinedAt", "updatedAt"
             ])
             && request.resource.data.uid == uid
             && request.resource.data.email == request.auth.token.email
             && request.resource.data.role == "runner"
             && request.resource.data.status == "active"
             && request.resource.data.invitationId is string
             && invite.eventId == eventId
             && invite.status == "accepted"
             && invite.targetUid == uid
             && (!invite.keys().hasAny(["targetEmail"]) || invite.targetEmail == request.auth.token.email);
    }
    function runnerAcceptsInvitation() {
      let emailMatches = request.auth.token.email is string
                         && resource.data.keys().hasAny(["targetEmail"])
                         && resource.data.targetEmail == request.auth.token.email;
      let uidMatches = resource.data.keys().hasAny(["targetUid"])
                       && resource.data.targetUid == request.auth.uid;
      return verified()
             && resource.data.status == "pending"
             && (emailMatches || uidMatches)
             && request.resource.data.status == "accepted"
             && request.resource.data.targetUid == request.auth.uid
             && (
               (uidMatches && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 "status", "acceptedAt", "updatedAt"
               ]))
               ||
               (emailMatches && !resource.data.keys().hasAny(["targetUid"])
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   "status", "targetUid", "acceptedAt", "updatedAt"
                 ]))
             );
    }
    function managerRevokesInvitation() {
      return verified()
             && managesEvent(resource.data.eventId)
             && resource.data.status == "pending"
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "status", "updatedAt", "revokedAt"
             ])
             && request.resource.data.status == "revoked";
    }
    function validInvitationTarget(data) {
      let usernameTarget = data.keys().hasAll(["targetUid", "targetUsername", "targetUsernameKey"])
                           && !data.keys().hasAny(["targetEmail"])
                           && validUsernameKey(data.targetUsernameKey)
                           && data.targetUsername == data.targetUsernameKey
                           && usernameDoc(data.targetUsernameKey).data.uid == data.targetUid;
      let emailTarget = data.keys().hasAny(["targetEmail"])
                        && data.targetEmail is string
                        && !data.keys().hasAny(["targetUid", "targetUsername", "targetUsernameKey"]);
      return usernameTarget || emailTarget;
    }


    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.uid == request.auth.uid
                    && !request.resource.data.keys().hasAny(["role", "roleMirror", "accountStatus", "permissions"])
                    && (!request.resource.data.keys().hasAny(["usernameKey"])
                        || (validUsernameKey(request.resource.data.usernameKey)
                            && request.resource.data.username == request.resource.data.usernameKey
                            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid));
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "displayName", "firstName", "lastName", "photoURL", "preferences", "updatedAt",
                      "emailVerified", "username", "usernameKey"
                    ])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["username", "usernameKey"])
                        || (
                          !resource.data.keys().hasAny(["usernameKey"])
                          && validUsernameKey(request.resource.data.usernameKey)
                          && request.resource.data.username == request.resource.data.usernameKey
                          && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid
                        ));
      allow delete: if false;
    }

    match /usernames/{usernameKey} {
      allow get: if validUsernameKey(usernameKey);
      allow list: if false;
      allow create: if signedIn()
                    && validUsernameKey(usernameKey)
                    && request.resource.data.keys().hasOnly([
                      "uid", "username", "usernameKey", "displayName", "createdAt", "updatedAt"
                    ])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == usernameKey
                    && request.resource.data.usernameKey == usernameKey;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.usernameKey == resource.data.usernameKey
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "updatedAt"]);
      allow delete: if false;
    }

    match /events/{eventId} {
      allow create: if verified() && isOrganizer()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == "draft";
      allow read: if signedIn() && (isSuperAdmin() || resource.data.ownerUid == request.auth.uid || isEventMember(eventId));
      allow update: if verified() && managesEvent(eventId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.kind == resource.data.kind
                    && validEventStatus(request.resource.data.status)
                    && validEventTransition(resource.data.status, request.resource.data.status)
                    && (request.resource.data.status != "prepared" || resource.data.status == "prepared" || preparedDataReady(request.resource.data))
                    && (designEditableStatus(resource.data.status) || lifecycleOnlyAfterPublication());
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || managesEvent(eventId));
        allow create: if (verified() && managesEvent(eventId)) || selfJoinFromAcceptedInvite(eventId, uid);
        allow update: if verified() && managesEvent(eventId);
        allow delete: if verified() && managesEvent(eventId);
      }

      match /courses/{courseId} {
        allow read: if signedIn() && (managesEvent(eventId) || isEventMember(eventId));
        allow write: if verified() && managesEvent(eventId)
                     && designEditableStatus(eventDoc(eventId).data.status);
      }

      match /checkpoints/{checkpointId} {
        allow read: if signedIn() && (managesEvent(eventId) || isEventMember(eventId));
        allow write: if verified() && managesEvent(eventId)
                     && designEditableStatus(eventDoc(eventId).data.status);
      }

      match /results/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || managesEvent(eventId));
        allow create, update: if verified() && managesEvent(eventId);
        allow delete: if false;
      }

      match /audit/{logId} {
        allow read: if signedIn() && managesEvent(eventId);
        allow write: if false;
      }
    }

    match /invitations/{inviteId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.keys().hasAny(["targetUid"]) && resource.data.targetUid == request.auth.uid) ||
        (request.auth.token.email is string && resource.data.keys().hasAny(["targetEmail"]) && resource.data.targetEmail == request.auth.token.email)
      );
      allow create: if verified() && isOrganizer()
                    && request.resource.data.eventId is string
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.role == "runner"
                    && request.resource.data.status == "pending"
                    && !request.resource.data.keys().hasAny(["acceptedAt", "revokedAt"])
                    && validInvitationTarget(request.resource.data)
                    && managesEvent(request.resource.data.eventId)
                    && (eventDoc(request.resource.data.eventId).data.status == "prepared" ||
                        eventDoc(request.resource.data.eventId).data.status == "published");
      allow update: if managerRevokesInvitation() || runnerAcceptsInvitation();
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if signedIn() && (isSuperAdmin() || exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)));
      allow write: if false;
      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
        allow write: if false;
      }
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
