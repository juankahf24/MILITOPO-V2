rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : "runner"; }
    function isSuperAdmin() { return signedIn() && role() == "super_admin"; }
    function isOrganizer() { return signedIn() && (role() == "organizer" || role() == "super_admin"); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function eventDoc(eventId) { return get(/databases/$(database)/documents/events/$(eventId)); }
    function isEventOwner(eventId) { return signedIn() && eventDoc(eventId).data.ownerUid == request.auth.uid; }
    function isEventMember(eventId) { return signedIn() && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)); }
    function managesEvent(eventId) { return isSuperAdmin() || (isOrganizer() && isEventOwner(eventId)); }
    function validEventStatus(status) {
      return status == "draft" || status == "prepared" || status == "published" ||
             status == "live" || status == "finished" || status == "archived";
    }
    function validEventTransition(before, after) {
      return before == after ||
             (before == "draft" && after == "prepared") ||
             (before == "prepared" && after == "published") ||
             (before == "published" && after == "live") ||
             (before == "live" && after == "finished") ||
             (before == "finished" && after == "archived");
    }
    function preparedDataReady(data) {
      return data.checkpointSyncedCount is int && data.checkpointSyncedCount >= 3 &&
             data.courseSyncedCount is int && data.courseSyncedCount >= 1;
    }
    function designEditableStatus(status) {
      return status == "draft" || status == "prepared";
    }
    function lifecycleOnlyAfterPublication() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "cloudStage", "lifecycleVersion", "updatedAt",
        "publishedAt", "liveAt", "finishedAt", "archivedAt"
      ]);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.uid == request.auth.uid
                    && !request.resource.data.keys().hasAny(["role", "roleMirror", "accountStatus", "permissions"]);
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "displayName", "firstName", "lastName", "photoURL", "preferences", "updatedAt"
                    ]);
      allow delete: if false;
    }

    match /events/{eventId} {
      allow create: if verified() && isOrganizer()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == "draft";
      allow read: if signedIn() && (isSuperAdmin() || resource.data.ownerUid == request.auth.uid || isEventMember(eventId));
      allow update: if verified() && managesEvent(eventId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.kind == resource.data.kind
                    && validEventStatus(request.resource.data.status)
                    && validEventTransition(resource.data.status, request.resource.data.status)
                    && (request.resource.data.status != "prepared" || resource.data.status == "prepared" || preparedDataReady(request.resource.data))
                    && (designEditableStatus(resource.data.status) || lifecycleOnlyAfterPublication());
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || managesEvent(eventId));
        allow create, update: if verified() && managesEvent(eventId);
        allow delete: if verified() && managesEvent(eventId);
      }

      match /courses/{courseId} {
        allow read: if signedIn() && (managesEvent(eventId) || isEventMember(eventId));
        allow write: if verified() && managesEvent(eventId)
                     && designEditableStatus(eventDoc(eventId).data.status);
      }

      match /checkpoints/{checkpointId} {
        allow read: if signedIn() && (managesEvent(eventId) || isEventMember(eventId));
        allow write: if verified() && managesEvent(eventId)
                     && designEditableStatus(eventDoc(eventId).data.status);
      }

      match /results/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || managesEvent(eventId));
        allow create, update: if verified() && managesEvent(eventId);
        allow delete: if false;
      }

      match /audit/{logId} {
        allow read: if signedIn() && managesEvent(eventId);
        allow write: if false;
      }
    }

    match /invitations/{inviteId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.targetUid == request.auth.uid ||
        (request.auth.token.email is string && resource.data.targetEmail == request.auth.token.email)
      );
      allow create: if verified() && isOrganizer()
                    && request.resource.data.eventId is string
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.targetEmail is string
                    && request.resource.data.role == "runner"
                    && request.resource.data.status == "pending"
                    && managesEvent(request.resource.data.eventId)
                    && (eventDoc(request.resource.data.eventId).data.status == "prepared" ||
                        eventDoc(request.resource.data.eventId).data.status == "published");
      allow update: if verified() && managesEvent(resource.data.eventId)
                    && request.resource.data.eventId == resource.data.eventId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.targetEmail == resource.data.targetEmail
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "status", "updatedAt", "revokedAt"
                    ])
                    && (request.resource.data.status == "pending" || request.resource.data.status == "revoked");
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if signedIn() && (isSuperAdmin() || exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)));
      allow write: if false;
      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
        allow write: if false;
      }
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
